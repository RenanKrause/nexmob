{
  "name": "@nexmob/qr-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:validator": "node scripts/generate-revision-validator.mjs",
    "check:validator": "node scripts/generate-revision-validator.mjs --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",

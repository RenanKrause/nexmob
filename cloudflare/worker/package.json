    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261016.1",
    "ajv": "^8.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "4.151.1"
  }
}

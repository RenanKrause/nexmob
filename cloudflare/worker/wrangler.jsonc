{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexmob-qr-api",
  // Task 3 adds the HTTP entry point (src/index.ts).
  "compatibility_date": "2026-10-17",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexmob-qr",
      // Local placeholder; configure the actual database ID before deployment.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REVISIONS",
      "bucket_name": "nexmob-qr-revisions"
    }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexmob-qr-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "vars": {
    // Replace with the exact public Pages origin before deployment.
    "PAGES_ORIGIN": "https://nexmob-qr.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexmob-qr",
      // Local placeholder; configure the actual database ID before deployment.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REVISIONS",
      "bucket_name": "nexmob-qr-revisions"
    }
  ]
}

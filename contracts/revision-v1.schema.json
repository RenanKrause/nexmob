{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexmob.dev/contracts/revision-v1.schema.json",
  "title": "RevisionV1",
  "description": "Manifesto imutável de uma revisão sincronizada do projeto Nex Mob.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "revision_id",
    "synced_at",
    "modules"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "project_id": { "type": "string", "minLength": 1 },
    "revision_id": { "type": "string", "minLength": 1 },
    "synced_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "name", "environment", "pieces"],
      "properties": {
        "module_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "environment": { "type": "string" },
        "pieces": {
          "type": "array",
          "items": { "$ref": "#/$defs/piece" }
        }
      }
    },
    "piece": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_key",
        "qr_token",
        "name",
        "cut_mm",
        "transform_mm",
        "material",
        "edge_banding",
        "visible"
      ],
      "properties": {
        "logical_key": { "type": "string", "minLength": 1 },
        "qr_token": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" },
        "name": { "type": "string", "minLength": 1 },
        "cut_mm": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 3,
          "maxItems": 3
        },
        "transform_mm": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x, y, z, rotation_z_deg], with translation in millimeters."
        },
        "material": { "type": "string", "minLength": 1 },
        "edge_banding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top", "right", "bottom", "left"],
          "properties": {
            "top": { "type": "boolean" },
            "right": { "type": "boolean" },
            "bottom": { "type": "boolean" },
            "left": { "type": "boolean" }
          }
        },
        "visible": { "type": "boolean" }
      }
    }
  }
}
